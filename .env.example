# ============================================================
# LMS environment variables — copy to .env and fill in values
#   cp .env.example .env
# ============================================================

# --- Security ---
# Generate a strong random secret:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# False in production, True for local development
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --- Database (Supabase / Render PostgreSQL) ---
# Leave empty to use local SQLite. Fill with your Supabase POSTGRES URL:
#   postgresql://postgres:<password>@<host>:5432/postgres
# with ?sslmode=require appended for Supabase.
DATABASE_URL=
