# ============================================================
# PRODUCTION (Render + Supabase)
# Используйте эти настройки для деплоя на Render.com
# ============================================================

# --- Security ---
# Сгенерируйте новый секретный ключ:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-production-secret-key-here

# ВАЖНО: Установите False в продакшене!
DJANGO_DEBUG=False

# Добавьте ваш домен Render (например: your-app.onrender.com)
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# --- Database (Supabase PostgreSQL) ---
# Получите эту строку из Supabase:
# Project Settings → Database → Connection string (URI)
# Формат: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:29101997.1064sh@db.tugldzcyfvmqogquzvif.supabase.co:5432/postgres?sslmode=require

# --- Media Files (Production) ---
# Для продакшена рекомендуется использовать S3/Cloudinary
# Но для начала можно использовать локальное хранилище Render
MEDIA_URL=/media/
MEDIA_ROOT=/opt/render/project/src/media
